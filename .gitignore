# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.p12
*.pfx
*.key
id_rsa
id_rsa.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env / secrets — keep examples, never commit real values
.env
.env.*
!.env.example
!.env*.example
*.local
credentials.json
service-account*.json
auth.json

# vercel / cloud
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / agents (local only)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.cursor/
.claude/
*.swp
*.swo

# OS / caches
.turbo
.cache
